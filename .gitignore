# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo

# Ignore virtual environments
.venv/
venv/
env/
*.egg-info/

# Ignore OS files
.DS_Store

# Ignore database and large CSVs
*.db
*.csv

# Ignore DLLs and other binaries
*.dll
*.exe
*.so
*.dylib

# Ignore Aider artifacts
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/
.continue/
